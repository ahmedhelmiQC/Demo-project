
{
  "compilerOptions": {
    "target": "ESNext",
    "module": "Node16",
    "moduleResolution": "Node16",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node", "@playwright/test"],
    "noEmit": true
  },
  "include": [
    "tests/**/*.ts",
    "Pages/**/*.ts",
    "API/**/*.ts",
    "Utils/**/*.ts"
  ]
}
